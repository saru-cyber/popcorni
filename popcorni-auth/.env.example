# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin of this portal.
# Add {SITE_URL}/auth/callback to Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Share the auth cookie across subdomains. Leave empty on localhost.
# Example: .popcorni.app
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Comma-separated origins that may receive a session handoff after Google sign-in.
NEXT_PUBLIC_AUTH_RETURN_ORIGINS=http://localhost:3002

# Stripe Payment Link for Pro. Leave empty until billing is connected.
NEXT_PUBLIC_STRIPE_PRO_CHECKOUT_URL=

# PollPop launch target from the portal.
NEXT_PUBLIC_POLLPOP_URL=http://localhost:3002
